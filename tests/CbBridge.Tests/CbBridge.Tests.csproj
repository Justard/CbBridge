<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Unit tests without any test package: a tiny runner (TestRunner.cs) finds every [Test] method and runs it.
    Run all:   dotnet run (project tests/CbBridge.Tests); exit code 0 = all passed.
    Filter:    pass a word after the project, e.g. Sqlite, to run only tests whose name contains it.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CbBridge.Core\CbBridge.Core.csproj" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
