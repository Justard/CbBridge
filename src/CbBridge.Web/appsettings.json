{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Branding": {
    "ProductName": "CB Test Bridge",
    "Tagline": "Test management ⇄ test framework",
    "CompanyName": "",
    "LogoUrl": "",
    "LogoHeight": 28,
    "FaviconUrl": "",
    "AccentColor": "#0E5E5A",
    "HeaderColor": "#15181C"
  },
  "Codebeamer": {
    "DefaultBaseUrl": "https://cb.yourcompany.com/cb",
    "LegacyPrefix": "/rest",
    "V3Prefix": "/api/v3",
    "PingPath": "/projects",
    "StepColumns": [ "Action", "Expected result", "Critical?" ],
    "FieldMap": {
      "ItemId": "id,uri",
      "Name": "name",
      "Parent": "parent",
      "Description": "description",
      "TestRunSteps": "testRunSteps,testSteps",
      "Parameters": "parameters,testParameters",
      "Modifier": "modifier",
      "TestConfigurationTemplate": "{releases} / {versions}",
      "TestConfigurationNameSeparator": ", ",
      "ExtraFields": {
        "releases": "releases,release",
        "versions": "versions,version"
      }
    }
  },
  "Framework": {
    "BaseUrl": "http://localhost:5001",
    "ExecutePath": "/execute",
    "CancelPath": "/cancel/{itemId}",
    "GraceSeconds": 15,
    "VerdictFields": "verdict,result,status",
    "MessageFields": "message,error"
  },
  "RunMultiple": {
    "TestRunTrackerId": "",
    "CreatePath": "/trackers/{trackerId}/testruns",
    "TestCaseField": "",
    "TestCaseTypes": [ "Test Case", "Testfall" ],
    "NewRunNameTemplate": "{name} · {testConfiguration}"
  },
  "Ci": {
    "Enabled": false,
    "ApiKey": "",
    "KeepJobs": 100,
    "DefaultTimeLimitSec": 120,
    "DefaultOverallLimitSec": 3600
  },
  "Results": {
    "Enabled": true,
    "Folder": "results",
    "KeepDays": 90
  },
  "PostBack": {
    "DryRun": true
  }
}
