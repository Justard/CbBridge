            "description": "Unknown or missing API key",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Key lacks the scope",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Not found, or this API is disabled",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/ci/runs/{id}/abort": {
      "post": {
        "tags": [
          "CI"
        ],
        "summary": "Stop a job and the running test",
        "description": "Scope: `runs:start`.",
        "security": [
          {
            "apiKey": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "description": "Unknown or missing API key",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Key lacks the scope",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Not found, or this API is disabled",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/analysis/callback/{analysisId}": {
      "post": {
        "tags": [
          "AI analysis"
        ],
        "summary": "AI agent sends its comment (asynchronous answer)",
        "description": "Single-use; token from the analysis request in `X-Callback-Token`. See docs/ai-analysis.md.",
        "security": [],
        "parameters": [
          {
            "name": "analysisId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Callback-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "comment": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "Unknown/expired ID or wrong token"
          }
        }
      }
    }
  },
  "webhooks": {
    "bridgeEvent": {
      "post": {
        "summary": "Event sent to Events:Subscribers",
        "description": "Headers: X-Bridge-Event (name), X-Bridge-Signature: sha256=<hex HMAC of the body with the subscriber's Secret>. With Format=text the body is {\"text\": \"…\"} instead.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Event"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Any 2xx = delivered (3 attempts otherwise)"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Problem": {
        "type": "object",
        "properties": {
          "status": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          }
        }
      },
      "RunSummary": {
        "type": "object",
        "required": [
          "id",
          "source",
          "startedAt",
          "summary",
          "link"
        ],
        "properties": {
          "id": {
            "type": "string",
            "examples": [
              "20261019-071558-4b2cc5"
            ]
          },
          "source": {
            "type": "string",
            "enum": [
              "console",
              "ci"
            ]
          },
          "startedBy": {
            "type": "string"
          },
          "label": {
            "type": [
              "string",
              "null"
            ]
          },
          "selection": {
            "type": "string"
          },
          "frameworkUrl": {
            "type": "string"
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "finishedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "summary": {
            "type": "object",
            "properties": {
              "total": {
                "type": "integer"
              },
              "passed": {
                "type": "integer"
              },
              "failed": {
                "type": "integer"
              },
              "blocked": {
                "type": "integer"
              },
              "timeout": {
                "type": "integer"
              },
              "error": {
                "type": "integer"
              },
              "notRun": {
                "type": "integer"
              }
            }
          },
          "link": {
            "type": "string",
            "format": "uri",
            "description": "Page in the bridge UI"
          }
        }
      },
      "Analysis": {
        "type": "object",
        "properties": {
          "state": {
            "type": "string",
            "enum": [
              "Pending",
              "Done",
              "NoAnswer",
              "Failed"
            ]
          },
          "comment": {
            "type": [
              "string",
              "null"
            ]
          },
          "commentUpload": {
            "type": [
              "string",
              "null"
            ]
          },
          "feedback": {
            "type": [
              "integer",
              "null"
            ],
            "enum": [
              1,
              -1,
              null
            ]
          },
          "feedbackBy": {
            "type": [
              "string",
              "null"
            ]
          },
          "agentAnswer": {
            "description": "Full answer of the AI agent (detail view only)"
          }
        }
      },
      "Result": {
        "type": "object",
        "required": [
          "runId",
          "position",
          "testKey",
          "name",
          "verdict"
        ],
        "properties": {
          "runId": {
            "type": "string"
          },
          "position": {
            "type": "integer",
            "description": "1-based place in the run"
          },
          "testKey": {
            "type": "string",
            "description": "'tc:<id>' for test cases, 'item:<id>' for test runs, 'local:<id>' for My tests",
            "examples": [
              "tc:10232"
            ]
          },
          "itemId": {
            "type": "string"
          },
          "testCaseId": {
            "type": [
              "string",
              "null"
            ]
          },
          "testablauf": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": "string"
          },
          "isLocal": {
            "type": "boolean"
          },
          "testConfiguration": {
            "type": [
              "string",
              "null"
            ]
          },
          "verdict": {
            "type": "string",
            "enum": [
              "PASSED",
              "FAILED",
              "BLOCKED",
              "TIMEOUT",
              "ABORTED",
              "ERROR",
              "NOTRUN",
              "QUEUED",
              "RUNNING"
            ]
          },
          "durationSec": {
            "type": "number"
          },
          "message": {
            "type": "string"
          },
          "codebeamerTestRunId": {
            "type": [
              "string",
              "null"
            ]
          },
          "upload": {
            "type": "string",
            "enum": [
              "NotPosted",
              "Posted",
              "DryRun",
              "Failed"
            ]
          },
          "savedAt": {
            "type": "string",
            "format": "date-time"
          },
          "analysis": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Analysis"
              },
              {
                "type": "null"
              }
            ]
          },
          "previousVerdict": {
            "type": "string",
            "enum": [
              "PASSED",
              "FAILED",
              "BLOCKED",
              "TIMEOUT",
              "ABORTED",
              "ERROR",
              "NOTRUN",
              "QUEUED",
              "RUNNING"
            ],
            "description": "Same test in the run before (lists only)"
          },
          "trend": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "NEW FAIL",
              "FIXED",
              null
            ]
          },
          "request": {
            "description": "Exact JSON sent to the framework (detail only)"
          },
          "response": {
            "description": "Framework's full answer (detail only)"
          },
          "uploadMessage": {
            "type": [
              "string",
              "null"
            ]
          },
          "link": {
            "type": "string",
            "format": "uri"
          }
        }
      },
      "RunDetail": {
        "allOf": [
          {
            "$ref": "#/components/schemas/RunSummary"
          },
          {
            "type": "object",
            "properties": {
              "results": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Result"
                }
              }
            }
          }
        ]
      },
      "HistoryPoint": {
        "type": "object",
        "properties": {
          "runId": {
            "type": "string"
          },
          "position": {
            "type": "integer"
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "verdict": {
            "type": "string",
            "enum": [
              "PASSED",
              "FAILED",
              "BLOCKED",
              "TIMEOUT",
              "ABORTED",
              "ERROR",
              "NOTRUN",
              "QUEUED",
              "RUNNING"
            ]
          },
          "durationSec": {
            "type": "number"
          },
          "testConfiguration": {
            "type": [
              "string",
              "null"
            ]
          },
          "source": {
            "type": "string"
          },
          "label": {
            "type": [
              "string",
              "null"
            ]
          },
          "aiComment": {
            "type": [
              "string",
              "null"
            ]
          },
          "link": {
            "type": "string",
            "format": "uri"
          }
        }
      },
      "AuditEntry": {
        "type": "object",
        "properties": {
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "actor": {
            "type": "string"
          },
          "action": {
            "type": "string",
            "examples": [
              "post result FAILED"
            ]
          },
          "target": {
            "type": "string",
            "examples": [
              "item:88132"
            ]
          },
          "outcome": {
            "type": "string",
            "enum": [
              "Posted",
              "DryRun",
              "Failed",
              "NotPosted"
            ]
          },
          "detail": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "CiRunRequest": {
        "type": "object",
        "description": "Exactly one of category, testablauf, testRun, testCase (ID or codebeamer link).",
        "properties": {
          "category": {
            "type": "string"
          },
          "testablauf": {
            "type": "string"
          },
          "testRun": {
            "type": "string"
          },
          "testCase": {
            "type": "string"
          },
          "onlyTestCases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "release": {
            "type": "string"
          },
          "versions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "codebeamerUrl": {
            "type": "string"
          },
          "frameworkUrl": {
            "type": "string"
          },
          "createNewRuns": {
            "type": "boolean",
            "default": true
          },
          "postBack": {
            "type": "boolean",
            "default": true
          },
          "analyze": {
            "type": "boolean",
            "default": false
          },
          "timeLimitSec": {
            "type": "integer"
          },
          "overallLimitSec": {
            "type": "integer"
          },
          "label": {
            "type": "string"
          }
        }
      },
      "CiJob": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "Queued",
              "Running",
              "Finished",
              "Failed",
              "Aborted"
            ]
          },
          "kind": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "frameworkUrl": {
            "type": "string"
          },
          "label": {
            "type": [
              "string",
              "null"
            ]
          },
          "runId": {
            "type": [
              "string",
              "null"
            ],
            "description": "ID in the history (/api/v1/runs/{runId})"
          },
          "summary": {
            "type": "object"
          },
          "results": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "logFrom": {
            "type": "integer"
          },
          "log": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "Event": {
        "type": "object",
        "required": [
          "event",
          "at",
          "run"
        ],
        "properties": {
          "event": {
            "type": "string",
            "enum": [
              "run.started",
              "run.finished",
              "test.failed",
              "analysis.done"
            ]
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "run": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "source": {
                "type": "string"
              },
              "startedBy": {
                "type": "string"
              },
              "selection": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "frameworkUrl": {
                "type": "string"
              },
              "link": {
                "type": "string"
              }
            }
          },
          "tests": {
            "type": "integer",
            "description": "run.started"
          },
          "summary": {
            "type": "object",
            "description": "run.finished"
          },
          "problems": {
            "type": "array",
            "description": "run.finished: failed tests (max 50)",
            "items": {
              "type": "object"
            }
          },
          "test": {
            "type": "object",
            "description": "test.failed, analysis.done"
          },
          "analysis": {
            "type": "object",
            "description": "analysis.done"
          }
        }
      }
    },
    "securitySchemes": {
      "apiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Api-Key"
      },
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Same key as X-Api-Key (not for /api/ci)"
      },
      "codebeamer": {
        "type": "http",
        "scheme": "basic",
        "description": "CI agent's codebeamer account (/api/ci/runs only)"
      }
    }
  }
}
