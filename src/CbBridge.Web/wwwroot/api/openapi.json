    "/api/v1/runs/{runId}/results/{position}/compare": {
      "get": {
        "tags": [
          "History"
        ],
        "summary": "Compare with the previous run and the last passing run",
        "description": "Scope: `history:read`.",
        "security": [
          {
            "apiKey": []
          },
          {
            "bearer": []
          }
        ],
        "parameters": [
          {
            "name": "runId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "position",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "result": {
                      "$ref": "#/components/schemas/Result"
                    },
                    "previous": {
                      "anyOf": [
                        {
                          "$ref": "#/components/schemas/Result"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "lastPassing": {
                      "anyOf": [
                        {
                          "$ref": "#/components/schemas/Result"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "responseChangesSinceLastPass": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "Changed lines of the framework answer, '+ ' now / '- ' then"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unknown or missing API key",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Key lacks the scope",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Not found, or this API is disabled",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Run history not available",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
