    "/api/ci/runs": {
      "post": {
        "tags": [
          "CI"
        ],
        "summary": "Start a run (Jenkins / any CI)",
        "description": "Scope: `runs:start`.\n\n`Authorization` carries the CI agent's own codebeamer login (Basic or Bearer); the API key goes in `X-Api-Key`.",
        "security": [
          {
            "apiKey": [],
            "codebeamer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CiRunRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "state": {
                      "type": "string"
                    },
                    "statusUrl": {
                      "type": "string"
                    },
                    "junitUrl": {
                      "type": "string"
                    }
