{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Codebeamer": {
    "DefaultBaseUrl": "http://localhost:5002/cb"
  },
  "Framework": {
    "BaseUrl": "http://localhost:5001"
  },
  "RunMultiple": {
    "TestRunTrackerId": "5502"
  },
  "Ci": {
    "Enabled": true,
    "ApiKey": "dev-only-key"
  },
  "PostBack": {
    "DryRun": false
  },
  "Bridge": {
    "PublicUrl": "http://localhost:5000"
  },
  "Api": {
    "Enabled": true,
    "Clients": [
      {
        "Name": "dev-agent",
        "Key": "dev-agent-key",
        "Scopes": [
          "history:read",
          "feedback:write",
          "audit:read",
          "runs:read",
          "runs:start"
        ],
        "CodebeamerUser": "jdoe",
        "CodebeamerPassword": "pw"
      },
      {
        "Name": "dev-jenkins",
        "Key": "dev-jenkins-key",
        "Scopes": [
          "runs:start",
          "runs:read"
        ]
      },
      {
        "Name": "dev-readonly",
        "Key": "dev-readonly-key",
        "Scopes": [
          "history:read"
        ]
      }
    ]
  },
  "Events": {
    "Subscribers": [
      {
        "Name": "dev-sink",
        "Url": "http://localhost:5004/hook",
        "Secret": "dev-event-secret"
      },
      {
        "Name": "dev-chat",
        "Url": "http://localhost:5004/hook",
        "Format": "text",
        "Events": [
          "run.finished"
        ],
        "OnlyProblems": true
      }
    ]
  }
}
