@inherits LayoutComponentBase
@inject CodebeamerSession Session
@inject NavigationManager Nav
@inject IOptions<BrandingOptions> BrandingOptions
@inject CbBridge.Core.Licensing.LicenceService Licence

<header class="topbar">
    <div class="topbar-left">
    <a class="brand" href="@(Session.IsSignedIn ? "/console" : "/")">
        <BrandMark />
        <span class="brand-text">
            <span class="brand-name">@BrandingOptions.Value.ProductName</span>
            <span class="brand-sub">@(string.IsNullOrWhiteSpace(BrandingOptions.Value.CompanyName) ? BrandingOptions.Value.Tagline : BrandingOptions.Value.CompanyName)</span>
        </span>
    </a>
    @if (Session.IsSignedIn)
    {
        <nav class="topnav" aria-label="Main">
            <NavLink href="/console" ActiveClass="active">Console</NavLink>
            <NavLink href="/history" ActiveClass="active">History</NavLink>
            <NavLink href="/benches" ActiveClass="active">Benches</NavLink>
            <NavLink href="/audit" ActiveClass="active">Audit</NavLink>
        </nav>
    }
    </div>
    <div class="topbar-right">
        @if (Session.IsSignedIn)
        {
            <span class="chip mono">@Session.BaseUrl</span>
            <span class="chip read">read · legacy REST</span>
            <span class="chip write">write · Swagger v3</span>
            <span class="chip mono">@Session.User</span>
            <button class="btn ghost" @onclick="SignOut">Sign out</button>
        }
    </div>
</header>

<main class="page">
    @if (!Licence.AllowsUse)
    {
        <LicenceLock />
    }
    else
    {
        @if (Licence.Check.State == CbBridge.Core.Licensing.LicenceState.ExpiringSoon)
        {
            <p class="warn">@Licence.Check.Message <a href="/licence">Licence</a></p>
        }
        else if (!Licence.Enforced && !Licence.Check.AllowsUse)
        {
            <p class="muted dev-licence">Development mode — licence not enforced (@Licence.Check.Message) <a href="/licence">Licence</a></p>
        }
        @Body
    }
</main>
<footer class="footer muted">@BrandingOptions.Value.ProductName @Version · © 2026 Justard · <a href="/licence">@(Licence.Check.Grant is { } g ? $"Licensed to {g.Licensee}" : "Licence")</a></footer>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    private static readonly string Version = typeof(MainLayout).Assembly.GetName().Version is { } v ? $"{v.Major}.{v.Minor}.{v.Build}" : "";

    private void SignOut()
    {
        Session.SignOut();
        Nav.NavigateTo("/");
    }
}
