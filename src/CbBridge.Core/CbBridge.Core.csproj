<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shared core: domain, use cases, codebeamer + framework clients. Used by the web console and the CLI. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CbBridge.Core</RootNamespace>
  </PropertyGroup>

  <!--
    Licence enforcement is a BUILD setting, not a config setting, so nobody can switch it off in appsettings.
    Prerelease builds (default: local builds, develop, feature branches, beta tags) show the licence but never block.
    Release builds enforce it:  dotnet publish -p:LicenceEnforced=true   (the release pipeline does this for vX.Y.Z tags).
  -->
  <PropertyGroup>
    <LicenceEnforced Condition="'$(LicenceEnforced)' == ''">false</LicenceEnforced>
    <DefineConstants Condition="'$(LicenceEnforced)' == 'true'">$(DefineConstants);LICENCE_ENFORCED</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- The licence public key (made with tools/LicenceTool keygen). Absent = builds are locked in production. -->
    <EmbeddedResource Include="Licensing\licence-public-key.pem" LogicalName="CbBridge.licence-public-key.pem" Condition="Exists('Licensing\licence-public-key.pem')" />
  </ItemGroup>

  <ItemGroup>
    <!-- Brings HttpClientFactory, Options, Logging, Configuration — no NuGet packages needed. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
